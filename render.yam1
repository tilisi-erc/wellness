services:
    - type: web
    name: tilisi-wellness-coach
    env: python
    region: singapore
    plan: free
    buildCommand: pip install --upgrade pip && pip install -r requirements.txt
    startCommand: uvicorn main:app --host 0.0.0.0 --port $PORT
    healthCheckPath: /welcome
    envVars:
            - key: PYTHON_VERSION
        value: 3.11.9
